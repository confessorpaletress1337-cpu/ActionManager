<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ActionManager.ViewModels"
        x:Class="ActionManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ActionManager — автоматизация Windows"
        Width="980" Height="720"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <!-- ШАПКА -->
        <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 12">
            <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Classes="h1" Text="⚡ ActionManager" />
                <TextBlock Classes="dim" Text="выключение и запуск рабочего окружения · Windows Task Scheduler" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                         IsVisible="{Binding IsChipOk}" Fill="{DynamicResource Brush.Ok}" />
                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                         IsVisible="{Binding IsChipWarn}" Fill="{DynamicResource Brush.Warn}" />
                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                         IsVisible="{Binding IsChipOff}" Fill="{DynamicResource Brush.TextDim}" />
                <TextBlock Text="{Binding PlannerChipText}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- БАННЕР ПРОБЛЕМЫ -->
        <Border Grid.Row="1" Classes="banner" IsVisible="{Binding HasConfigProblem}" Margin="0 0 0 12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⚠️" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding ConfigProblemText}" TextWrapping="Wrap" MaxWidth="640" />
                </StackPanel>
                <Button Grid.Column="1" Content="Повторить" Command="{Binding RetryConfigureCommand}"
                        VerticalAlignment="Top" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
          <TabItem Header="Выключение">
           <!-- КОНТЕНТ: КАЛЕНДАРЬ + БОКОВАЯ ПАНЕЛЬ -->
           <Grid ColumnDefinitions="*,330" ColumnSpacing="14" Margin="0 10 0 0">

            <!-- КАЛЕНДАРЬ -->
            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0 0 0 10">
                        <TextBlock Classes="h2" Text="{Binding Calendar.MonthTitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="nav" Content="Сегодня" Command="{Binding Calendar.GoToTodayCommand}" Margin="0 0 6 0" />
                        <Button Grid.Column="2" Classes="nav" Content="＜" Command="{Binding Calendar.PrevMonthCommand}" Margin="0 0 6 0" />
                        <Button Grid.Column="3" Classes="nav" Content="＞" Command="{Binding Calendar.NextMonthCommand}" />
                    </Grid>

                    <!-- дни недели -->
                    <UniformGrid Grid.Row="1" Columns="7" Margin="0 0 0 6">
                        <TextBlock Classes="mini" Text="Пн" HorizontalAlignment="Center" />
                        <TextBlock Classes="mini" Text="Вт" HorizontalAlignment="Center" />
                        <TextBlock Classes="mini" Text="Ср" HorizontalAlignment="Center" />
                        <TextBlock Classes="mini" Text="Чт" HorizontalAlignment="Center" />
                        <TextBlock Classes="mini" Text="Пт" HorizontalAlignment="Center" />
                        <TextBlock Classes="mini" Text="Сб" HorizontalAlignment="Center" />
                        <TextBlock Classes="mini" Text="Вс" HorizontalAlignment="Center" />
                    </UniformGrid>

                    <!-- сетка дней -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Calendar.Cells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarDayViewModel">
                                <Button Classes="daycell"
                                        Command="{Binding SelectCommand}"
                                        ToolTip.Tip="{Binding ToolTipText}"
                                        IsEnabled="{Binding IsSelectable}">
                                    <Panel>
                                        <Border CornerRadius="12" Background="{DynamicResource Brush.Card2}"
                                                IsVisible="{Binding IsPast}" />
                                        <StackPanel Orientation="Vertical" Spacing="6"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="10 8 0 0"
                                                    IsVisible="{Binding !IsPlaceholder}">
                                            <!-- число: обычное / зачёркнутое для отменённого -->
                                            <TextBlock Text="{Binding DayNumber}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Text}"
                                                       IsVisible="{Binding !IsCanceled}" />
                                            <TextBlock Text="{Binding DayNumber}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Text}"
                                                       TextDecorations="Strikethrough"
                                                       IsVisible="{Binding IsCanceled}" />
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="7" Height="7" IsVisible="{Binding IsPlanned}"
                                                         Fill="{DynamicResource Brush.Ok}" />
                                                <Ellipse Width="7" Height="7" IsVisible="{Binding IsCanceled}"
                                                         Fill="{DynamicResource Brush.Canceled}" />
                                                <Ellipse Width="7" Height="7" IsVisible="{Binding IsOff}"
                                                         Fill="{DynamicResource Brush.Warn}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- приглушение прошедшего дня -->
                                        <Border CornerRadius="12" IsHitTestVisible="False"
                                                Background="#9912141C" IsVisible="{Binding IsPast}" />
                                        <!-- рамка выделения -->
                                        <Border CornerRadius="12" BorderThickness="2"
                                                BorderBrush="{DynamicResource Brush.Accent}"
                                                IsVisible="{Binding IsSelected}" />
                                    </Panel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- БОКОВАЯ ПАНЕЛЬ -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" Spacing="14">

                    <!-- расписание -->
                    <Border Classes="card">
                        <StackPanel Orientation="Vertical" Spacing="10">
                            <TextBlock Classes="h2" Text="Расписание" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="Выключать в" VerticalAlignment="Center" />
                                <TimePicker Grid.Column="1"
                                            SelectedTime="{Binding ShutdownTime, Mode=TwoWay}"
                                            ClockIdentifier="24HourClock"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="Планировщик включён" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding SchedulerEnabled, Mode=TwoWay}"
                                              OnContent="Вкл"
                                              OffContent="Выкл" />
                            </Grid>
                            <TextBlock Classes="mini"
                                       Text="каждый день · за 3 минуты до этого Windows даст предупреждение"
                                       TextWrapping="Wrap" />
                            <Button Content="Открыть планировщик Windows" Command="{Binding OpenWindowsPlannerCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- следующее выключение -->
                    <Border Classes="card">
                        <StackPanel Orientation="Vertical" Spacing="6">
                            <TextBlock Classes="dim" Text="СЛЕДУЮЩЕЕ ВЫКЛЮЧЕНИЕ" />
                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding NextShutdownSummary}" />
                            <TextBlock Text="{Binding NextShutdownCountdown}" Foreground="{DynamicResource Brush.Accent}" />
                            <Border Height="1" Background="{DynamicResource Brush.CardBorder}" Margin="0 6 0 2" />
                            <TextBlock Classes="mini" Text="{Binding LastRunSummary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- выбранный день -->
                    <Border Classes="card">
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <TextBlock Classes="dim" Text="ВЫБРАННЫЙ ДЕНЬ" />
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding SelectedDayTitle}" />
                            <TextBlock Classes="mini" Text="{Binding Calendar.SelectedStateText}" TextWrapping="Wrap" />
                            <Button Content="{Binding SelectedDayActionText}"
                                    Command="{Binding ToggleSelectedSkipCommand}"
                                    IsEnabled="{Binding CanToggleSelectedDay}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- быстрые действия -->
                    <Border Classes="card">
                        <StackPanel Orientation="Vertical" Spacing="10">
                            <TextBlock Classes="h2" Text="Быстрые действия" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Content="🌙 Сон" Command="{Binding SleepNowCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="🛌 Гибернация" Command="{Binding HibernateNowCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" Content="🔒 Блок" Command="{Binding LockNowCommand}"
                                        HorizontalAlignment="Stretch" />
                            </Grid>
                            <Button Classes="danger" Content="{Binding PowerOffButtonText}"
                                    Command="{Binding PowerOffNowCommand}"
                                    HorizontalAlignment="Stretch" MinHeight="38" />
                            <Button Content="Отменить ожидающее выключение"
                                    Command="{Binding CancelPendingShutdownCommand}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
           </Grid>
          </TabItem>

          <TabItem Header="Рабочий пул">
            <Grid ColumnDefinitions="*,320" ColumnSpacing="14" Margin="0 10 0 0">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="h2" Text="Приложения и проекты" />
                    <TextBlock Classes="dim" Text="Все включённые элементы откроются вместе по одной кнопке." />
                  </StackPanel>

                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="＋ Файлы и программы" Click="BrowsePoolFiles_Click" />
                    <Button Content="＋ Папка проекта" Click="BrowsePoolFolder_Click" />
                    <Button Content="＋ .NET проект" Click="BrowseDotNetProject_Click" />
                  </StackPanel>

                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox PlaceholderText="URL или путь, например https://google.com"
                             Text="{Binding NewPoolTarget, Mode=TwoWay}" />
                    <Button Grid.Column="1" Content="Добавить"
                            Command="{Binding AddTypedPoolTargetCommand}" />
                  </Grid>

                  <Grid Grid.Row="3">
                    <Border Classes="poolEmpty" IsVisible="{Binding !HasLaunchPoolItems}">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <TextBlock FontSize="28" Text="🚀" HorizontalAlignment="Center" />
                        <TextBlock Text="Пул пока пуст" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Classes="dim" Text="Добавьте Docker, решения Visual Studio, папки и сайты." />
                      </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasLaunchPoolItems}">
                      <ItemsControl ItemsSource="{Binding LaunchPoolItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LaunchPoolItemViewModel">
                            <Border Classes="poolItem">
                              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              OnContent="" OffContent=""
                                              VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="6">
                                  <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Название" />
                                  <TextBox Text="{Binding Target, Mode=TwoWay}" PlaceholderText="Путь или URL" />
                                  <TextBox Text="{Binding Arguments, Mode=TwoWay}"
                                           PlaceholderText="Аргументы, например: run --project &quot;путь.csproj&quot;" />
                                  <TextBox Text="{Binding WorkingDirectory, Mode=TwoWay}"
                                           PlaceholderText="Рабочая папка (необязательно)" />
                                  <CheckBox Content="Не запускать повторно, если уже открыто"
                                            IsChecked="{Binding SkipIfRunning, Mode=TwoWay}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="iconDanger" Content="✕"
                                        Click="RemovePoolItem_Click"
                                        ToolTip.Tip="Удалить из пула"
                                        VerticalAlignment="Top" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Grid>
              </Border>

              <StackPanel Grid.Column="1" Spacing="14">
                <Button Content="▶ Запустить пул сейчас"
                        Command="{Binding LaunchPoolNowCommand}"
                        HorizontalAlignment="Stretch" VerticalContentAlignment="Center" MinHeight="48"  />

                <Border Classes="card">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="h2" Text="Что можно добавить" />
                    <TextBlock Classes="mini" TextWrapping="Wrap"
                               Text="• .exe или ярлык — приложение&#x0a;• .sln — решение Visual Studio&#x0a;• .NET проект — запуск через dotnet run&#x0a;• папку — откроется в Проводнике&#x0a;• URL — откроется в браузере" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </TabItem>
        </TabControl>

        <!-- СТАТУС-БАР -->
        <TextBlock Grid.Row="3" Classes="mini" Margin="0 12 0 0"
                   Text="{Binding StatusLogText}" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
